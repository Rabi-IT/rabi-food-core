// Alloy config for Grafana Cloud — reference file.
// In production (ECS), this content is embedded in Terraform and injected
// via the ALLOY_CONFIG environment variable into the sidecar container.
//
// Required environment variables:
//   GRAFANA_PROMETHEUS_URL            — e.g. https://prometheus-prod-XX.grafana.net/api/prom/push
//   GRAFANA_PROMETHEUS_INSTANCE_ID    — numeric instance ID from Grafana Cloud
//   GRAFANA_LOKI_URL                  — e.g. https://logs-prod-XX.grafana.net/loki/api/v1/push
//   GRAFANA_LOKI_INSTANCE_ID          — numeric instance ID from Grafana Cloud
//   GRAFANA_TOKEN                     — API token with MetricsPublisher + LogsPublisher scopes

// ─── Metrics ──────────────────────────────────────────────────────────────────

prometheus.scrape "app" {
  targets         = [{"__address__" = "localhost:3000"}]
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
  scrape_interval = "15s"
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = env("GRAFANA_PROMETHEUS_URL")

    basic_auth {
      username = env("GRAFANA_PROMETHEUS_INSTANCE_ID")
      password = env("GRAFANA_TOKEN")
    }
  }
}

// ─── Logs (local dev only — in ECS logs go via awslogs → CloudWatch) ─────────

loki.write "grafana_cloud" {
  endpoint {
    url = env("GRAFANA_LOKI_URL")

    basic_auth {
      username = env("GRAFANA_LOKI_INSTANCE_ID")
      password = env("GRAFANA_TOKEN")
    }
  }
}
